{
  "name": "ai-collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:ui": "node scripts/dev-gateway.mjs",
    "dev:local": "bash scripts/cloud-dev-start.sh",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "verify:skills": "node scripts/verify-skills-bootstrap.mjs",
    "typecheck": "npm run verify:skills && tsc --noEmit",
    "lint": "echo \"No lint configured yet\"",
    "test": "npm run verify:skills && vitest run"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bullmq": "^6.1.2",
    "dotenv": "^16.5.0",
    "fastify": "^4.29.0",
    "ioredis": "^6.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "vitest": "^3.2.4"
  }
}
