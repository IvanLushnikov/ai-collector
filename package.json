{
  "name": "ai-collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:ui": "node scripts/dev-gateway.mjs",
    "dev:local": "bash scripts/cloud-dev-start.sh",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "verify:skills": "node scripts/verify-skills-bootstrap.mjs",
    "typecheck": "npm run verify:skills && tsc --noEmit",
    "lint": "eslint .",
    "lint:staged": "lint-staged",
    "prepare": "husky",
    "test": "npm run verify:skills && vitest run"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": "eslint --max-warnings=0 --no-warn-ignored"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.1.2",
    "dotenv": "^16.5.0",
    "fastify": "^4.29.0",
    "ioredis": "^6.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.7",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.4"
  }
}
