# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Trust X-Forwarded-* from reverse proxy (set true in production behind Caddy/nginx)
TRUST_PROXY=false

# Database (local: docker-compose.dev.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_collector

# Redis (reserved for BullMQ workers; optional for current MVP API path)
REDIS_URL=redis://127.0.0.1:6379

# Security — never commit real values
# Session cookies are opaque; JWT_SECRET is reserved for future token signing.
# In production: random string, min 32 characters.
JWT_SECRET=

# Comma-separated browser origins allowed for CORS + CSRF Origin checks.
# Local UI gateway: http://localhost:8080 (and Vite if used)
# Production: https://example.com (same-origin cabinet — list the public origin)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080
# Dev/test only. Must stay unset/false in production.
ALLOW_HEADER_IDENTITY=true

# Billing (RUB)
BILLING_CONNECTED_MINUTE_RATE_RUB=1.2

# API rate limit (per client IP; ineffective across multi-instance without shared store)
API_RATE_LIMIT_MAX_REQUESTS=120
API_RATE_LIMIT_WINDOW_MS=60000

# Exolve Voice API (secret store only; leave empty locally)
EXOLVE_API_KEY=
EXOLVE_APPLICATION_ID=

# Live calls (keep false until DPA, probe and legal basis are ready)
LIVE_CALLS_ENABLED=false

# Optional async sandbox start stub (default synchronous path)
SANDBOX_CALLS_QUEUE_ENABLED=false

# Mango Office / Mangotelecom (secret store only; leave empty locally)
MANGO_API_KEY=
MANGO_API_SALT=

# Envelope encryption for tenant speech credentials (32-byte hex = 64 hex chars)
# Generate: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=

# Yandex SpeechKit / YandexGPT / GigaChat (secret store only; leave empty locally)
YANDEX_SPEECHKIT_API_KEY=
YANDEXGPT_API_KEY=
GIGACHAT_API_KEY=
YANDEX_FOLDER_ID=

# --- Production compose only (see docker-compose.yml / docs/operations/DEPLOYMENT.md) ---
# DOMAIN=example.com
# ACME_EMAIL=admin@example.com
# POSTGRES_USER=ai_collector
# POSTGRES_PASSWORD=
# POSTGRES_DB=ai_collector
# PUBLIC_ORIGIN=https://example.com
